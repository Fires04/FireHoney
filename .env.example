# Copy this to .env and edit it. .env is not committed to git (see
# .gitignore) -- it holds passwords.
#
#   cp .env.example .env
#   $EDITOR .env

# ============================================================
# Ports published on the host
# ============================================================
COWRIE_SSH_PORT=2222
COWRIE_TELNET_PORT=2223
GRAFANA_PORT=3000
SESSION_VIEWER_PORT=8080

# ============================================================
# Grafana
# ============================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-please

# ============================================================
# Session viewer (basic-auth, protects the captured-session overview)
# ============================================================
VIEWER_USER=viewer
VIEWER_PASSWORD=change-me-too

# ============================================================
# Firewall (scripts/firewall.sh) -- see docs/SECURITY.md
# ============================================================
# The host's network interface facing the internet/LAN. Find it with:
# ip route | grep default
WAN_IFACE=eth0

# Where the admin is allowed to reach SSH/Grafana/session-viewer from
# (CIDR or a single IP/32). NEVER leave this as 0.0.0.0/0.
ADMIN_CIDR=192.168.1.0/24

# DNS resolvers the Cowrie container is allowed to reach (nothing else)
# -- needed to resolve URLs the attacker supplies when downloading a
# malware sample.
DNS_RESOLVERS=1.1.1.1,9.9.9.9

# ============================================================
# Internal Docker subnets -- only change these on a conflict with an
# existing network
# ============================================================
COWRIE_EGRESS_SUBNET=172.30.0.0/24
COWRIE_IP=172.30.0.10
MGMT_PUBLISH_SUBNET=172.31.0.0/24

# ============================================================
# Loki -- log retention
# ============================================================
LOKI_RETENTION_HOURS=2160

# ============================================================
# Session generator -- how often (seconds) to look for newly captured
# sessions and regenerate webui/index.html
# ============================================================
SESSION_GENERATOR_INTERVAL=120

# Minimum seconds between frames in the web player's terminal replay.
# Automated attackers often paste a whole command chain with ~0s gaps,
# which flies by unreadably fast at real speed -- this floors every
# gap so it stays watchable. Doesn't affect sessions already paced
# like human typing. Set to 0 to disable and replay at true speed.
SESSION_MIN_FRAME_DELAY=0.05
