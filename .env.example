# Zkopíruj na .env a uprav. .env se necommituje (viz .gitignore) --
# obsahuje hesla.
#
#   cp .env.example .env
#   $EDITOR .env

# ============================================================
# Porty publikované na hostu
# ============================================================
COWRIE_SSH_PORT=2222
COWRIE_TELNET_PORT=2223
GRAFANA_PORT=3000
SESSION_VIEWER_PORT=8080

# ============================================================
# Grafana
# ============================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-please

# ============================================================
# Session viewer (basic-auth, chrání přehled zachycených relací)
# ============================================================
VIEWER_USER=viewer
VIEWER_PASSWORD=change-me-too

# ============================================================
# Firewall (scripts/firewall.sh) -- viz docs/SECURITY.md
# ============================================================
# Síťové rozhraní hostu směrem do internetu/LAN. Zjisti: ip route | grep default
WAN_IFACE=eth0

# Odkud smí správce na SSH/Grafanu/session-viewer (CIDR nebo jedna IP/32).
# NIKDY nenechávej 0.0.0.0/0.
ADMIN_CIDR=192.168.1.0/24

# DNS resolvery, na které smí Cowrie kontejner (jinak nikam) -- pro
# resolvnutí URL, které útočník zadá při stahování malware vzorku.
DNS_RESOLVERS=1.1.1.1,9.9.9.9

# ============================================================
# Interní Docker podsítě -- měnit jen při konfliktu s existující sítí
# ============================================================
COWRIE_EGRESS_SUBNET=172.30.0.0/24
COWRIE_IP=172.30.0.10
MGMT_PUBLISH_SUBNET=172.31.0.0/24

# ============================================================
# Loki -- retence logů
# ============================================================
LOKI_RETENTION_HOURS=2160

# ============================================================
# Generátor přehledu relací -- jak často (sekundy) hledat nové
# zachycené relace a generovat webui/index.html
# ============================================================
SESSION_GENERATOR_INTERVAL=120
