{
  "id": null,
  "uid": "cowrie-overview",
  "title": "Cowrie Honeypot — Overview",
  "tags": [
    "cowrie",
    "honeypot"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Total sessions (selected period)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.session.connect\" [$__range]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Successful logins (selected period)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.login.success\" [$__range]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Failed logins (selected period)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.login.failed\" [$__range]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Downloaded malware samples",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.session.file_download\" [$__range]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Login attempts over time (success vs. failure)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum by (eventid) (count_over_time({job=\"cowrie\"} | json | eventid=~\"cowrie.login.*\" [1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Live stream — commands run by attackers",
      "type": "logs",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{job=\"cowrie\"} | json | eventid=\"cowrie.command.input\" | line_format \"{{.src_ip}} > {{.input}}\"",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Live stream — all events",
      "type": "logs",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{job=\"cowrie\"} | json | line_format \"[{{.eventid}}] {{.src_ip}} — {{.message}}\"",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Most common username/password combos (selected period)",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Attempt count"
              },
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "eventid"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Result"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        }
      ],
      "targets": [
        {
          "expr": "topk(20, sum by (username, password, eventid) (count_over_time({job=\"cowrie\"} | json | eventid=~\"cowrie.login.*\" [$__range])))",
          "refId": "A",
          "instant": true,
          "queryType": "instant",
          "format": "table"
        }
      ]
    },
    {
      "id": 9,
      "title": "Most common commands run by attackers (selected period)",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Times run"
              },
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "input"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Command"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        }
      ],
      "targets": [
        {
          "expr": "topk(25, sum by (input) (count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.command.input\" [$__range])))",
          "refId": "A",
          "instant": true,
          "queryType": "instant",
          "format": "table"
        }
      ]
    },
    {
      "id": 10,
      "title": "Attacking IPs (selected period)",
      "type": "table",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Sessions"
              },
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "src_ip"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Source IP"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        }
      ],
      "targets": [
        {
          "expr": "topk(50, sum by (src_ip) (count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.session.connect\" [$__range])))",
          "refId": "A",
          "instant": true,
          "queryType": "instant",
          "format": "table"
        }
      ]
    },
    {
      "id": 11,
      "title": "Attack origin map (needs GeoIP enabled -- see docs/CONFIGURATION.md)",
      "type": "geomap",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 50
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "view": {
          "id": "zero",
          "lat": 20,
          "lon": 0,
          "zoom": 1.5
        },
        "layers": [
          {
            "type": "markers",
            "name": "Attacker sessions",
            "config": {
              "style": {
                "size": {
                  "fixed": 5,
                  "min": 2,
                  "max": 15,
                  "field": "Value"
                },
                "color": {
                  "fixed": "#f2495c"
                },
                "opacity": 0.6
              }
            },
            "location": {
              "mode": "coords",
              "latitudeField": "geoip_location_latitude",
              "longitudeField": "geoip_location_longitude"
            }
          }
        ],
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true
        }
      },
      "targets": [
        {
          "expr": "topk(200, sum by (src_ip, geoip_country_name, geoip_city_name, geoip_location_latitude, geoip_location_longitude) (count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.session.connect\" [$__range])))",
          "refId": "A",
          "instant": true,
          "queryType": "instant",
          "format": "table"
        }
      ]
    }
  ]
}
