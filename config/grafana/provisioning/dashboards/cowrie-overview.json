      "targets": [
        {
          "expr": "topk(15, sum by (password) (count_over_time({job=\"cowrie\"} | json | eventid=~\"cowrie.login.*\" [$__range])))",
          "refId": "A",
          "instant": true,
          "queryType": "instant",
          "format": "table"
