{
  "id": null,
  "uid": "cowrie-overview",
  "title": "Cowrie Honeypot — Overview",
  "tags": [
    "cowrie",
    "honeypot"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Total sessions (selected period)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.session.connect\" [$__range]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Successful logins (selected period)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.login.success\" [$__range]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Failed logins (selected period)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.login.failed\" [$__range]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Downloaded malware samples",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.session.file_download\" [$__range]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "title": "Overview",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      }
    },
    {
      "id": 5,
      "title": "Login attempts over time (success vs. failure)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*success.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*failed.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum by (eventid) (count_over_time({job=\"cowrie\"} | json | eventid=~\"cowrie.login.*\" [$__interval]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 21,
      "title": "Logins — what's being tried",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      }
    },
    {
      "id": 6,
      "title": "Top usernames tried (selected period)",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Attempts"
              },
              {
                "id": "custom.align",
                "value": "right"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "username"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Username"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        }
      ],
      "targets": [
        {
          "expr": "topk(15, sum by (username) (count_over_time({job=\"cowrie\"} | json | eventid=~\"cowrie.login.*\" [$__range])))",
          "refId": "A",
          "instant": true,
          "queryType": "instant",
          "format": "table"
        }
      ]
    },
