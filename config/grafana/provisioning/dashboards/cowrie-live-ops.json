{
  "id": null,
  "uid": "cowrie-live-ops",
  "title": "Cowrie Honeypot — Live Ops",
  "description": "Real-time pulse of the honeypot -- active sessions, connection rate, live feed. For studying individual attacks, see the 'Human Hunt' dashboard instead.",
  "tags": [
    "cowrie",
    "honeypot",
    "live"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "id": 30,
      "title": "Right now",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 1,
      "title": "Active sessions (approx., 15m window)",
      "description": "Connects minus closes in the last 15 minutes. Approximate: a session open longer than 15m briefly disappears from this count. Good for 'is anything happening right now', not a precise count.",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 15
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "clamp_min(sum(count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.session.connect\" [15m])) - sum(count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.session.closed\" [15m])), 0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "New sessions (last 5m)",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.session.connect\" [5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Commands run (last 5m)",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.command.input\" [5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Unique source IPs (selected period)",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "count(count by (src_ip) (count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.session.connect\" [$__range])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 31,
      "title": "Trends",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      }
    },
    {
      "id": 5,
      "title": "New sessions per minute",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "fillOpacity": 60,
            "lineWidth": 1
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.session.connect\" [$__interval]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Commands per minute",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 0,
            "fillOpacity": 60,
            "lineWidth": 1
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"cowrie\"} | json | eventid=\"cowrie.command.input\" [$__interval]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 32,
      "title": "Live feed",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      }
    },
    {
      "id": 7,
      "title": "Newest sessions",
      "type": "logs",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{job=\"cowrie\"} | json | eventid=\"cowrie.session.connect\" | line_format \"{{.src_ip}} -- new session {{.session}} ({{.protocol}})\"",
          "refId": "A"
        }
      ]
    }
  ]
}
